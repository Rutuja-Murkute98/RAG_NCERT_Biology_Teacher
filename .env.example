# Copy this file to .env and fill in your GCP project ID.
#
# This whole project runs on GCP (Vertex AI). Auth uses Application Default
# Credentials (`gcloud auth application-default login`) -- no API key files
# needed anywhere.

GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_CAPTIONING_MODEL=gemini-2.5-flash

# Approach 2's joint image+text embedding model. Only reachable via the
# "global" endpoint right now, not GOOGLE_CLOUD_LOCATION above.
MULTIMODAL_EMBEDDING_MODEL_NAME=gemini-embedding-2
MULTIMODAL_EMBEDDING_LOCATION=global

LLM_PROVIDER=google
LLM_MODEL=gemini-2.5-flash
