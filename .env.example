# Copy this file to .env and fill in your free Gemini API key.
#
# Get one at https://aistudio.google.com/apikey -- no credit card, not tied
# to any GCP project or billing account. This is Google's separate free
# Developer API, not Vertex AI.

GEMINI_API_KEY=

# "-lite-latest" aliases, not pinned versions -- deliberately, so a future
# model retirement (this project hit exactly that once already:
# gemini-2.5-flash got blocked for new API keys mid-project) doesn't
# silently break this again. Specifically the LITE variant, not plain
# "-latest": that one resolved to gemini-3.6-flash, whose free tier is only
# 20 requests/DAY (found for real after it silently ran out mid-session).
# gemini-*-flash-lite consistently gets a far more generous free-tier quota.
GEMINI_CAPTIONING_MODEL=gemini-flash-lite-latest
LLM_PROVIDER=google
LLM_MODEL=gemini-flash-lite-latest

# Optional. Where data/raw_pdfs, data/extracted, data/chroma, and
# record_manager.sqlite3 live. Defaults to <repo>/data, which is correct for
# local dev -- only set this in production, to a persistent disk's mount path.
# DATA_DIR=

# Optional, unrelated to the AI features above. Direct-download URL to a zip
# of a pre-built data/ folder (see bootstrap.py) -- only relevant if
# deploying to a host with no persistent disk (e.g. Render's Free tier),
# where the already-built index gets downloaded fresh on every cold start.
# A GitHub Release asset on this repo works well -- free, public, no GCP
# billing account involved at all (an earlier version of this used a GCS
# bucket, which broke in production the moment the linked GCP project's
# billing went delinquent -- Google blocks Cloud Storage downloads for the
# whole project when that happens, even from a public bucket with no
# credentials). If you'd rather avoid any external data-hosting step, this
# is skippable: leave it unset and re-run scripts/index_all_chapters.py
# directly wherever you deploy instead (now genuinely free, since
# captioning/embedding no longer cost anything on the Developer API's free tier).
# DATA_ZIP_URL=
