# Copy this file to .env and fill in your GCP project ID.
#
# This whole project runs on GCP (Vertex AI). Locally, auth uses Application
# Default Credentials (`gcloud auth application-default login`) -- no API key
# files needed. In production (e.g. Render), use a service account key
# instead -- see README.md's Deployment section -- and set
# GOOGLE_APPLICATION_CREDENTIALS to point to it.

GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Optional. Where data/raw_pdfs, data/extracted, data/chroma, and
# record_manager.sqlite3 live. Defaults to <repo>/data, which is correct for
# local dev -- only set this in production, to a persistent disk's mount path
# (see README.md's Deployment section for why this matters on Render).
# DATA_DIR=
GEMINI_CAPTIONING_MODEL=gemini-2.5-flash

# Approach 2's joint image+text embedding model. Only reachable via the
# "global" endpoint right now, not GOOGLE_CLOUD_LOCATION above.
MULTIMODAL_EMBEDDING_MODEL_NAME=gemini-embedding-2
MULTIMODAL_EMBEDDING_LOCATION=global

LLM_PROVIDER=google
LLM_MODEL=gemini-2.5-flash
