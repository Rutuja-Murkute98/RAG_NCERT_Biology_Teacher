# Copy this file to .env and fill in your free Gemini API key.
#
# Get one at https://aistudio.google.com/apikey -- no credit card, not tied
# to any GCP project or billing account. This is Google's separate free
# Developer API, not Vertex AI.

GEMINI_API_KEY=

# "-latest" aliases, not pinned versions -- deliberately, so a future model
# retirement (this project hit exactly that once already: gemini-2.5-flash
# got blocked for new API keys mid-project) doesn't silently break this again.
GEMINI_CAPTIONING_MODEL=gemini-flash-latest
LLM_PROVIDER=google
LLM_MODEL=gemini-flash-latest

# Optional. Where data/raw_pdfs, data/extracted, data/chroma, and
# record_manager.sqlite3 live. Defaults to <repo>/data, which is correct for
# local dev -- only set this in production, to a persistent disk's mount path.
# DATA_DIR=

# Optional, unrelated to the AI features above. Name of a GCS bucket holding
# a pre-built data/ folder (see bootstrap.py) -- only relevant if deploying
# to a host with no persistent disk (e.g. Render's Free tier), where the
# already-built index gets downloaded fresh on every cold start. Cloud
# Storage here is just cheap file hosting, not billed the way Vertex AI
# was -- but if you'd rather avoid GCP entirely, this is skippable: leave it
# unset and re-run scripts/index_all_chapters.py directly wherever you
# deploy instead (now genuinely free, since captioning/embedding no longer
# cost anything on the Developer API's free tier).
# GCS_DATA_BUCKET=
